<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- BepInEx 6 IL2CPP builds target net6.0; check the target your BepInEx build documents. -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Set once: setx AmongUsPath "C:\Program Files (x86)\Steam\steamapps\common\Among Us" -->
    <GamePath>$(AmongUsPath)</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by BepInEx the first time you launch the modded game -->
    <Reference Include="$(GamePath)/BepInEx/core/*.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/interop/*.dll" Private="false" />
    <!-- Reactor + MiraAPI: drop their DLLs in BepInEx/plugins, reference them here -->
    <Reference Include="$(GamePath)/BepInEx/plugins/Reactor.dll" Private="false" />
    <Reference Include="$(GamePath)/BepInEx/plugins/MiraAPI.dll" Private="false" />
  </ItemGroup>

  <!-- Copy the built DLL straight into the game for quick testing -->
  <Target Name="CopyToGame" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GamePath)/BepInEx/plugins/" />
  </Target>
</Project>
